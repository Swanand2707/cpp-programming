#include<iostream>
using namespace std;
class student
{
    int roll;
    char name[25];

public:
    void getdata()
    {
        cout<<"Enter Roll Number: ";
        cin>>roll;

        cout<<"Enter Student Name: ";
        cin>>name;
    }
    void putdata()
    {
        cout<<"\nRoll No: "<<roll<<endl;
        cout<<"Student Name: "<<name<<endl;
    }
};
class StudentExam : public student
{
public:
    int sub1,sub2,sub3,sub4,sub5,sub6;

    void accept_data()
    {
        getdata();

        cout<<"Enter Marks of Subject 1: ";
        cin>>sub1;
        cout<<"Enter Marks of Subject 2: ";
        cin>>sub2;
        cout<<"Enter Marks of Subject 3: ";
        cin>>sub3;
        cout<<"Enter Marks of Subject 4: ";
        cin>>sub4;
        cout<<"Enter Marks of Subject 5: ";
        cin>>sub5;
        cout<<"Enter Marks of Subject 6: ";
        cin>>sub6;
    }

    void display_data()
    {
        putdata();
        cout<<"Subject 1: "<<sub1<<endl;
        cout<<"Subject 2: "<<sub2<<endl;
        cout<<"Subject 3: "<<sub3<<endl;
        cout<<"Subject 4: "<<sub4<<endl;
        cout<<"Subject 5: "<<sub5<<endl;
        cout<<"Subject 6: "<<sub6<<endl;
    }
class Studentresult : public student
{
    int sub1,sub2,sub3,sub4,sub5,sub6;
    float per;
public:
    void accept_marks()
    {
        getdata();
        cout<<"Enter Marks of Subject 1: ";
        cin>>sub1;
        cout<<"Enter Marks of Subject 2: ";
        cin>>sub2;
        cout<<"Enter Marks of Subject 3: ";
        cin>>sub3;
        cout<<"Enter Marks of Subject 4: ";
        cin>>sub4;
        cout<<"Enter Marks of Subject 5: ";
        cin>>sub5;
        cout<<"Enter Marks of Subject 6: ";
        cin>>sub6;
    }
    void calculate()
    {
        per=(sub1+sub2+sub3+sub4+sub5+sub6)/6.0;
        putdata();
        cout<<"Total Percentage: "<<per<<"%"<<endl;
    }
};
int main()
{
    StudentExam exam;
    Studentresult result;
    cout<<"\n--- Student Exam ---\n";
    exam.accept_data();
    exam.display_data();
    cout<<"\n--- Student Result ---\n";
    result.accept_marks();
    result.calculate();
}
